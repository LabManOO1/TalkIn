@startuml
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

LAYOUT_WITH_LEGEND()

title Диаграмма развертывания TalkSphere (Level 2)

Deployment_Node(client, "Рабочая станция сотрудника", "Windows / Linux / macOS") {
    Container(browser, "Веб-приложение", "React, браузер", "Клиент HTTPS 443 и WSS 443.")
}

Deployment_Node(iot, "Переговорная комната", "IoT-периферия") {
    Container(devices, "Камера и микрофон комнаты", "Hardware", "Телеметрия устройств встречи.")
}

Deployment_Node(cloud, "Облачная инфраструктура (ЦОД)", "Yandex Cloud VPC") {
    Deployment_Node(edge, "Шлюз периметра", "Ubuntu Linux VM, публичный IP") {
        Container(nginx, "Reverse Proxy", "Nginx", "TLS-терминация, балансировка, порты 443 и 8883.")
        Container(mosquitto, "IoT Broker", "Mosquitto", "MQTTS для телеметрии устройств комнаты.")
    }

    Deployment_Node(apps, "Сервер приложений", "Ubuntu, Docker Host, приватная подсеть") {
        Container(api, "Backend API", "Docker, FastAPI :8000", "Комнаты, JWT, сигналинг, чат.")
        Container(board, "Доска", "Docker, FastAPI :8001", "WSS холста.")
        Container(filesvc, "Файловый сервис", "Docker, FastAPI :8002", "Папка встречи на томе /storage.")
        Container(webstatic, "Статика веб-клиента", "Docker, Nginx :80", "Сборка Vite.")
    }

    Deployment_Node(dbm, "Сервер БД Master", "Managed PostgreSQL") {
        ContainerDb(db_master, "PostgreSQL Master", "PostgreSQL 16 :5432", "Запись пользователей, встреч, чата.")
    }
    Deployment_Node(dbr, "Сервер БД Replica", "Managed PostgreSQL") {
        ContainerDb(db_replica, "PostgreSQL Replica", "PostgreSQL 16 :5432", "Только чтение, репликация Master-Replica.")
    }
}

Deployment_Node(ext, "Внешний контур", "SaaS") {
    System_Ext(iam, "IAM Keycloak", "OAuth2 :443")
    System_Ext(crm, "CRM", "gRPC :443")
    System_Ext(payment, "Финансовая система", "HTTPS :443")
    System_Ext(mail, "Почта", "SMTP/TLS :587")
    System_Ext(ai, "Сервис ИИ", "HTTPS :443")
}

Rel(browser, nginx, "Сайт, REST и WSS", "HTTPS/WSS, TLS 1.3, порт 443")
Rel(devices, mosquitto, "Статус камеры и микрофона", "MQTTS, TLS, порт 8883")
Rel(nginx, webstatic, "Статика React", "HTTP, порт 80")
Rel(nginx, api, "Прокси /api и /ws", "HTTP/WS, порт 8000")
Rel(nginx, board, "Прокси /board", "WS, порт 8001")
Rel(nginx, filesvc, "Прокси /files", "HTTP, порт 8002")
Rel(mosquitto, api, "Телеметрия устройств комнаты", "MQTT/TCP, localhost")
Rel(api, db_master, "Запись", "SQL/TCP, TLS, порт 5432")
Rel(api, db_replica, "Чтение календаря", "SQL/TCP, TLS, порт 5432")
Rel(board, db_master, "Снимок доски", "SQL/TCP, TLS, порт 5432")
Rel(db_master, db_replica, "Потоковая репликация", "PostgreSQL replication, TCP 5432")
Rel(api, iam, "introspect token", "HTTPS / OAuth2, порт 443")
Rel(api, crm, "sync_meeting", "gRPC, TLS, порт 443")
Rel(api, payment, "create_payment_intent", "HTTPS, порт 443")
Rel(api, mail, "Письмо-приглашение", "SMTP/TLS, порт 587")
Rel(api, ai, "Запрос отчёта", "HTTPS, порт 443")
Rel(api, filesvc, "close_folder", "HTTP, порт 8002")
@enduml
