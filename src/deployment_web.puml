@startuml
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

LAYOUT_WITH_LEGEND()

title Локальный сегмент развертывания: веб-приложение

Deployment_Node(client, "Рабочая станция сотрудника", "ОС браузера") {
    Container(browser, "Веб-приложение", "React, Vite build", "Клиентский контейнер.")
}

Deployment_Node(cloud, "Yandex Cloud VPC", "ЦОД") {
    Deployment_Node(edge, "Шлюз периметра", "Ubuntu VM") {
        Container(nginx, "Reverse Proxy", "Nginx", "TLS 1.3, порт 443.")
    }
    Deployment_Node(apps, "Docker Host", "Ubuntu") {
        Container(webstatic, "Статика веб-клиента", "Nginx :80", "Сборка фронтенда.")
        Container(api, "Backend API", "FastAPI :8000", "REST и WSS.")
    }
}

Rel(browser, nginx, "Страницы, REST, WSS", "HTTPS/WSS, TLS, порт 443")
Rel(nginx, webstatic, "index.html и бандлы", "HTTP, порт 80")
Rel(nginx, api, "Прокси API", "HTTP, порт 8000")
@enduml
