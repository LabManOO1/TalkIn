@startuml
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Ландшафт L0: модуль файлового сервиса TalkSphere

Person(participant, "Участник встречи", "Загружает файл в папку встречи.")
Person(organizer, "Организатор встречи", "После встречи закрывает папку.")

Enterprise_Boundary(corp, "Корпоративная ИТ-инфраструктура организации") {
    System(talksphere, "TalkSphere", "Файловый сервис: каталог одной встречи, лимиты, закрытие папки.")
    System(iam, "Корпоративный IAM", "Проверка JWT перед upload и download.")
    System(crm, "Корпоративная CRM", "Ссылка на пакет файлов в карточке сделки.")
}

Rel(participant, talksphere, "Загрузка и скачивание файла встречи", "HTTPS")
Rel(organizer, talksphere, "Закрытие папки после окончания", "HTTPS")
Rel(talksphere, iam, "assert_open / verify token", "HTTPS / OAuth2")
Rel(talksphere, crm, "attach_files(meeting_id, file_ids)", "gRPC")
@enduml
