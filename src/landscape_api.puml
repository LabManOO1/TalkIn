@startuml
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Ландшафт L0: модуль Backend API TalkSphere

Person(organizer, "Организатор встречи", "Создаёт комнату и завершает встречу.")

Enterprise_Boundary(corp, "Корпоративная ИТ-инфраструктура организации") {
    System(talksphere, "TalkSphere", "Backend API — ядро комнат, JWT, приглашений и сигналинга.")
    System(iam, "Корпоративный IAM", "Проверка токена сотрудника.")
    System(crm, "Корпоративная CRM", "Синхронизация встречи и статуса сделки.")
}

System_Boundary(ext, "Внешние сервисы") {
    System_Ext(payment, "Внешняя финансовая система", "Эквайринг. Подтверждение оплаты бронирования.")
    System_Ext(mail, "Почтовый сервис", "Письмо-приглашение.")
    System_Ext(calendar, "Google Календарь", "Событие встречи.")
    System_Ext(ai, "Сервис ИИ", "Отчёт после завершения.")
}

Rel(organizer, talksphere, "create_meeting, end_meeting", "HTTPS/JSON")
Rel(talksphere, iam, "get_current_user / introspect token", "HTTPS / OAuth2")
Rel(talksphere, crm, "sync_meeting(meeting_id, participants)", "gRPC")
Rel(talksphere, payment, "create_payment_intent", "HTTPS / JSON")
Rel(talksphere, mail, "Письмо-приглашение", "SMTP/TLS 587")
Rel(talksphere, calendar, "Создание события", "HTTPS/JSON")
Rel(talksphere, ai, "Запрос отчёта", "HTTPS/JSON")
@enduml
