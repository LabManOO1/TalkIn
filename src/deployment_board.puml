@startuml
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

LAYOUT_WITH_LEGEND()

title Локальный сегмент развертывания: доска

Deployment_Node(client, "Рабочая станция", "Браузер") {
    Container(browser, "Веб-приложение", "React", "Клиент WSS доски.")
}

Deployment_Node(cloud, "Yandex Cloud VPC", "ЦОД") {
    Deployment_Node(edge, "Шлюз периметра", "Ubuntu VM") {
        Container(nginx, "Reverse Proxy", "Nginx", "WSS, TLS 1.3, порт 443.")
    }
    Deployment_Node(apps, "Docker Host", "Ubuntu") {
        Container(board, "Доска", "Docker, FastAPI :8001", "BoardController.")
        Container(api, "Backend API", "Docker :8000", "verify JWT.")
    }
    Deployment_Node(dbm, "БД Master", "Managed PostgreSQL") {
        ContainerDb(db_master, "PostgreSQL Master", ":5432", "board_snapshots.")
    }
}

Rel(browser, nginx, "WSS /board", "WSS, TLS, порт 443")
Rel(nginx, board, "Прокси WebSocket", "WS, порт 8001")
Rel(board, api, "GET /auth/me, GET /rooms/{code}", "HTTPS, порт 8000")
Rel(board, db_master, "load_snapshot / save_snapshot", "SQL/TCP TLS, порт 5432")
@enduml
