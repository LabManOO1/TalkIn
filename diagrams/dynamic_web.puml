@startuml
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Runtime веб-приложения — вход сотрудника и открытие комнаты

Person(participant, "Участник", "Открывает браузер.")
Container(web_app, "Веб-приложение", "React", "App, AuthProvider, ApiClient.")
System_Ext(iam, "Корпоративный IAM", "Keycloak")
Container(api, "Backend API", "FastAPI", "Профиль и комната.")
Container(board, "Доска", "WSS", "Холст встречи.")
Container(files, "Файловый сервис", "HTTPS", "Папка встречи.")

Rel(participant, web_app, "1. GET /conference/{invite_code}", "HTTPS")
Rel(web_app, iam, "2. login() / Authorization Code", "HTTPS / OAuth2")
Rel(iam, web_app, "3. access_token в AuthProvider", "HTTPS / OAuth2")
Rel(web_app, api, "4. GET /rooms/{invite_code}", "HTTPS/JSON")
Rel(web_app, api, "5. WSS /ws/signal/{invite_code}", "WSS")
Rel(web_app, board, "6. WSS /ws/board/{invite_code}?token=", "WSS")
Rel(web_app, files, "7. GET /files/{invite_code}", "HTTPS")
@enduml
