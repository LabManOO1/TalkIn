@startuml
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Runtime доски — join сессии и применение фигуры

Container(web_app, "Веб-приложение", "React", "Клиент холста.")
Container(board, "Доска", "FastAPI / WSS", "BoardController, SessionManager, CanvasEngine.")
Container(api, "Backend API", "FastAPI", "GET /auth/me, GET /rooms/{code}")
ContainerDb(database, "База снимков доски", "SQLite / PostgreSQL", "board_snapshots")

Rel(web_app, board, "1. WSS /ws/board/{invite_code}?token=", "WSS")
Rel(board, api, "2. AccessClient.verify(token, invite_code)", "HTTPS/JSON")
Rel(api, board, "3. UserContext + room_id", "HTTPS/JSON")
Rel(board, database, "4. BoardRepository.load_snapshot(room_id)", "SQL/TCP")
Rel(board, web_app, "5. joined + snapshot", "WSS")
Rel(web_app, board, "6. {type: shape, base_revision, payload}", "WSS")
Rel(board, database, "7. save_snapshot после ShapeOperation.apply", "SQL/TCP")
Rel(board, web_app, "8. broadcast shape всем в комнате", "WSS")
@enduml
