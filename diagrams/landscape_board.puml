@startuml
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Ландшафт L0: модуль общей доски TalkSphere

Person(participant, "Участник встречи", "Рисует фигуры и видит курсоры коллег.")

Enterprise_Boundary(corp, "Корпоративная ИТ-инфраструктура организации") {
    System(talksphere, "TalkSphere", "Микросервис доски внутри платформы встреч.")
    System(iam, "Корпоративный IAM", "Проверка токена до допуска к холсту.")
    System(crm, "Корпоративная CRM", "Фиксация факта совместной работы на доске.")
}

Rel(participant, talksphere, "Фигуры и курсоры доски", "WSS")
Rel(talksphere, iam, "verify(token) перед join сессии", "HTTPS / OAuth2")
Rel(talksphere, crm, "Событие board_session_started", "gRPC")
@enduml
