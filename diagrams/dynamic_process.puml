@startuml
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Динамическая диаграмма — проведение корпоративной видеовстречи

Person(organizer, "Организатор", "Создаёт встречу и завершает комнату.")
Person(participant, "Участник", "Входит в комнату, пишет в чат и грузит файл.")

System_Ext(iam, "Корпоративный IAM", "OAuth2 / Keycloak")
System_Ext(crm, "Корпоративная CRM", "Карточка встречи")
System_Ext(payment, "Внешняя финансовая система", "Оплата бронирования")
System_Ext(mail, "Почтовый сервис", "Письмо-приглашение")
System_Ext(ai, "Сервис ИИ", "Отчёт по итогам")

Container(web_app, "Веб-приложение", "React", "Клиент в браузере.")
Container(api, "Backend API", "FastAPI", "create_meeting, signaling, end_meeting.")
Container(board, "Доска", "FastAPI / WSS", "join, apply_op.")
Container(files, "Файловый сервис", "FastAPI", "upload, close_folder.")
ContainerDb(database, "База данных", "PostgreSQL", "Комнаты, чат, снимок доски.")

Rel(organizer, web_app, "1. Открывает форму создания встречи", "HTTPS")
Rel(web_app, iam, "2. Запрос access token сотрудника", "HTTPS / OAuth2")
Rel(iam, web_app, "3. Возврат JWT / access token", "HTTPS / OAuth2")
Rel(web_app, api, "4. create_meeting(title, start, emails)", "HTTPS/JSON")
Rel(api, payment, "5. create_payment_intent(meeting_id)", "HTTPS/JSON")
Rel(payment, api, "6. payment_confirmed", "HTTPS/JSON")
Rel(api, database, "7. INSERT rooms, scheduled_conferences", "SQL/TCP 5432")
Rel(api, crm, "8. sync_meeting(meeting_id, participants)", "gRPC")
Rel(api, mail, "9. Письмо-приглашение", "SMTP/TLS 587")
Rel(participant, web_app, "10. Вход в комнату по invite_code", "HTTPS")
Rel(web_app, api, "11. join_room + handle_signal SDP/ICE", "HTTPS, WSS")
Rel(web_app, board, "12. join(invite_code, token)", "WSS")
Rel(board, api, "13. GET /auth/me и GET /rooms/{code}", "HTTPS/JSON")
Rel(web_app, files, "14. POST /files/{code} upload", "HTTPS")
Rel(files, api, "15. verify token и участие во встрече", "HTTPS/JSON")
Rel(organizer, web_app, "16. Завершает встречу", "HTTPS")
Rel(web_app, api, "17. end_meeting(invite_code)", "HTTPS/JSON")
Rel(api, files, "18. POST /files/{code}/close", "HTTPS")
Rel(api, ai, "19. Итоги: чат, участники, длительность", "HTTPS/JSON")
Rel(ai, api, "20. Текст отчёта по встрече", "HTTPS/JSON")
@enduml
